# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001

# ── Storage (optional) ────────────────────────────────────────────────────
# Defaults already avoid Android's shared /storage mount (SQLite can't
# create journal files there) - METADATA_DB_PATH/OUTPUT_DIR sit next to
# this repo, TRANSCRIPTION_DB_PATH/LOG_DIR/TEMP_DIR under Termux's own
# private app home (~/.local/share/audiobook-transcriber). Only set these
# if you deliberately want the files somewhere else, e.g. shared storage
# so a file manager can see them directly.
# METADATA_DB_PATH=/path/to/metadata.db
# LOG_DIR=/path/to/logs

# ── Auth (REQUIRED) ──────────────────────────────────────────────────────
# Long random string used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start if this is missing or still the placeholder.
JWT_SECRET=change-me-to-a-long-random-string
# How long a login token stays valid (days). 30 is a comfortable default
# for a single-device self-hosted setup.
JWT_EXPIRY_DAYS=30

# ── Password hashing (optional) ──────────────────────────────────────────
# PBKDF2-HMAC-SHA256 iterations. 200000 is the OWASP-recommended baseline
# for 2024+ hardware. Higher = slower register/login, more brute-force
# resistance. Only tune if you know what you're doing.
# PBKDF2_ITERATIONS=200000